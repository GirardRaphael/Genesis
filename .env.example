# Copy to .env locally. Never commit .env or paste API keys into chat.
GENESIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GENESIS_ANTHROPIC_MODEL=claude-sonnet-5-5
GENESIS_ANTHROPIC_ECONOMY_MODEL=claude-haiku-5-5
GENESIS_ANTHROPIC_VERIFIER_MODEL=claude-opus-5-5
# Aggregate user-authorized ceiling; per-call reservations are shared by all runs.
GENESIS_GLOBAL_BUDGET_CAD=100
# Conservative spending policy cushion, not a market exchange-rate quote.
GENESIS_CAD_PER_USD=2
GENESIS_PRICE_FILE=config/anthropic-prices.json
GENESIS_DATABASE_URL=sqlite:///data/genesis.db
GENESIS_CHECKPOINT_PATH=data/checkpoints.sqlite
GENESIS_DEMO_HOST=127.0.0.1
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Used only by optional docker compose PostgreSQL profile; replace locally.
GENESIS_DB_PASSWORD=

# Keyless local map prototype. Use owned services for business deployment.
GENESIS_GEOCODER_URL=https://photon.komoot.io
GENESIS_ROUTER_URL=https://router.project-osrm.org
