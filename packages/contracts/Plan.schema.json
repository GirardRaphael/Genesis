      "title": "Scope",
      "type": "string"
    },
    "parent_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Plan Id"
    }
  },
  "required": [
    "id",
    "input_hash",
    "matrix_hash",
    "policy",
    "routes",
    "unserved_ids",
    "distance_m",
    "operating_cost_cents",
    "penalty_cents",
    "objective_cents",
    "solver_status",
    "solver_runtime_ms",
    "solver_version",
    "search_limit_s",
    "diagnostics",
    "scope",
    "parent_plan_id"
