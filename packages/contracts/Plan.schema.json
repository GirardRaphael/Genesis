      "type": "integer"
    },
    "operating_cost_cents": {
      "default": 0,
      "title": "Operating Cost Cents",
      "type": "integer"
    },
    "penalty_cents": {
      "default": 0,
      "title": "Penalty Cents",
      "type": "integer"
    },
    "objective_cents": {
      "default": 0,
      "title": "Objective Cents",
      "type": "integer"
    },
    "solver_status": {
      "title": "Solver Status",
      "type": "string"
    },
    "solver_runtime_ms": {
      "default": 0,
      "title": "Solver Runtime Ms",
      "type": "number"
    },
    "solver_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solver Version"
    },
    "search_limit_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
