      "title": "Id",
      "type": "string"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "matrix_hash": {
      "title": "Matrix Hash",
      "type": "string"
    },
    "policy": {
      "title": "Policy",
      "type": "string"
    },
