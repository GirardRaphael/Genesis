          "type": "array"
        },
        "departure_s": {
          "title": "Departure S",
          "type": "integer"
        },
        "return_s": {
          "title": "Return S",
          "type": "integer"
        },
        "initial_load": {
          "title": "Initial Load",
          "type": "integer"
        },
        "distance_m": {
          "title": "Distance M",
          "type": "integer"
        },
        "travel_s": {
          "title": "Travel S",
          "type": "integer"
        },
        "service_s": {
          "title": "Service S",
          "type": "integer"
        },
        "waiting_s": {
          "title": "Waiting S",
          "type": "integer"
        },
        "duty_s": {
          "title": "Duty S",
          "type": "integer"
        },
        "operating_cost_cents": {
          "title": "Operating Cost Cents",
          "type": "integer"
        },
        "geometry": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Geometry",
          "type": "array"
        },
        "geometry_source": {
          "default": "schematic synthetic grid — not road verified",
