      "required": [
        "vehicle_id",
        "stop_ids",
        "visits",
        "departure_s",
        "return_s",
        "initial_load",
        "distance_m",
        "travel_s",
        "service_s",
        "waiting_s",
        "duty_s",
        "operating_cost_cents",
        "geometry",
        "geometry_source"
