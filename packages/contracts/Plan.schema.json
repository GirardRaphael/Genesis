    "Visit": {
      "additionalProperties": false,
      "properties": {
        "stop_id": {
          "title": "Stop Id",
          "type": "string"
        },
        "arrival_s": {
          "title": "Arrival S",
          "type": "integer"
        },
        "service_start_s": {
          "title": "Service Start S",
          "type": "integer"
        },
        "departure_s": {
          "title": "Departure S",
          "type": "integer"
        },
        "load_after": {
          "title": "Load After",
          "type": "integer"
